# ========================================================
# أثر — إعدادات البيئة وقاعدة بيانات Supabase
# Athar — Environment & Supabase Database Configuration
# ========================================================

# Django Secret Key & Debug Mode
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=True

# --------------------------------------------------------
# 1. الاتصال الموصى به عبر Supabase Connection Pooler:
# Go to Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI -> Mode: Transaction (port 6543)
# --------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --------------------------------------------------------
# 2. أو الاتصال المباشر (Direct Connection):
# Go to Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI -> Mode: Session (port 5432)
# --------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# --------------------------------------------------------
# 3. أو عبر المتغيرات الفردية:
# --------------------------------------------------------
# SUPABASE_DB_HOST=aws-0-[REGION].pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.[PROJECT-REF]
# SUPABASE_DB_PASSWORD=[YOUR-PASSWORD]

# --------------------------------------------------------
# 4. مفاتيح واجهة Supabase API (اختياري للتوسعات المستقبلية):
# --------------------------------------------------------
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------------------------------------------------
# Athar Assistant (AI) — optional
# The assistant works fully offline. Set a key to upgrade the rewriting path to
# any OpenAI-compatible endpoint (hosted answers are merged with the local ones,
# and the local engine still answers if the hosted call fails).
# --------------------------------------------------------
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --------------------------------------------------------
# Time zone (defaults to UTC)
# --------------------------------------------------------
# TIME_ZONE=Africa/Algiers
